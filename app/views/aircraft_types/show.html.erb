<% content_for :page_title, @aircraft_type.full_name -%>
<% content_for :page_description, "Details for #{@aircraft_type.full_name}" -%>
<% content_for :page_actions do %>
  <%= link_to aircraft_types_path, class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
    Back to aircraft types
  <% end %>
<% end -%>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2">
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
        <h3 class="text-lg font-medium leading-6 text-gray-900">Aircraft Type Information</h3>
      </div>
      <dl>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Name</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @aircraft_type.name %></dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Type Code</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <span class="font-mono font-bold"><%= @aircraft_type.type_code || '-' %></span>
          </dd>
        </div>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Manufacturer</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <% if @aircraft_type.manufacturer %>
              <%= link_to @aircraft_type.manufacturer.name, manufacturer_path(@aircraft_type.manufacturer), class: "text-indigo-600 hover:text-indigo-500" %>
            <% else %>
              -
            <% end %>
          </dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Category</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @aircraft_type.category&.titleize || '-' %></dd>
        </div>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Wake Turbulence Category</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @aircraft_type.wtc || '-' %></dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Engines</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <% if @aircraft_type.engines %>
              <%= @aircraft_type.engines %> &times; <%= @aircraft_type.engine_type || 'Unknown' %>
            <% else %>
              -
            <% end %>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <div>
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
        <h3 class="text-lg font-medium leading-6 text-gray-900">Statistics</h3>
      </div>
      <dl>
        <div class="bg-gray-50 px-4 py-5 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Aircraft in fleet</dt>
          <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @aircraft_type.aircraft_count %></dd>
        </div>
      </dl>
    </div>
  </div>
</div>

<% if @aircraft.any? %>
  <div class="mt-8">
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
        <h3 class="text-lg font-medium leading-6 text-gray-900">Aircraft</h3>
      </div>
      <div class="flow-root">
        <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
          <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
            <table class="min-w-full divide-y divide-gray-300">
              <thead>
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">
                  Registration
                </th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 hidden lg:table-cell">
                  Configuration
                </th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
                  Operated By
                </th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 hidden lg:table-cell">
                  Owner
                </th>
                <th scope="col" class="py-3.5 text-left text-sm font-semibold text-gray-900 sm:pl-0">
                  Status
                </th>
                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                  <span class="sr-only">View</span>
                </th>
              </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 bg-white" id='aircraft_list'>
              <% @aircraft.each do |aircraft| %>
                <tr>
                  <td class="whitespace-nowrap py-5 pl-4 pr-3 text-sm sm:pl-6">
                    <div class="flex items-center">
                      <div class="size-14 ml-1 bg-gray-500 border-2 border-purple-700 rounded-2xl overflow-hidden flex items-center">
                        <i class="fa-solid fa-plane size-10 mx-auto text-purple-400 -rotate-45"></i>
                      </div>
                      <div class="ml-4">
                        <span class="font-medium text-gray-900"><%= aircraft.registration %></span>
                        <div class="mt-1 text-gray-500"><%= aircraft.icao %></div>
                      </div>
                    </div>
                  </td>
                  <td class="whitespace-nowrap px-3 py-5 text-sm hidden lg:table-cell">
                    <div>
                      <% if aircraft.cabin_configuration&.present? %>
                        <span class="text-gray-900">
                          <%= cabin_configuration(aircraft.cabin_configuration).join(', ') %>
                        </span>
                      <% end %>
                    </div>
                    <div class="mt-1 text-gray-500"><%= aircraft.engine_count -%>x <%= aircraft.engine_model %></div>
                  </td>
                  <td class="whitespace-nowrap px-3 py-5 text-sm text-gray-500">
                    <div>
                      <span class="text-gray-900">
                        <%= aircraft.operator&.name || 'Unknown Operator' %>
                      </span>
                      <% if aircraft.operator&.icao_code || aircraft.operator&.iata_code -%>
                        <span class="text-gray-500">
                          (<%= [aircraft.operator&.icao_code, aircraft.operator&.iata_code].compact.join('/') %>)
                        </span>
                      <% end %>
                    </div>
                    <div class="mt-1 hidden md:block">
                      <% if aircraft.aircraft_name %>
                        <span class="text-gray-500 italic">
                          as &quot;<%= aircraft.aircraft_name %>&quot;
                        </span>
                      <% end %>
                    </div>
                  </td>
                  <td class="whitespace-nowrap px-3 py-5 text-sm text-gray-500 hidden lg:table-cell">
                    <div class="text-gray-900"><%= aircraft.owner&.titleize || "Unknown Owner" %></div>
                  </td>
                  <td class="whitespace-nowrap py-5">
                    <%= aircraft_status_badge(aircraft.status) %>
                  </td>
                  <td class="whitespace-nowrap py-5 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                    <%= link_to 'View', aircraft_path(aircraft), class: "text-indigo-600 hover:text-indigo-900" %>
                  </td>
                </tr>
              <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <% if @pagy.pages > 1 %>
        <div class="px-4 py-3 border-t border-gray-200 sm:px-6">
          <div class="flex items-center justify-between">
            <div class="text-sm text-gray-700">
              Showing <span class="font-medium"><%= @pagy.from %></span> to
              <span class="font-medium"><%= @pagy.to %></span> of <span class="font-medium"><%= @pagy.count %></span>
              aircraft
            </div>
            <div>
              <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>