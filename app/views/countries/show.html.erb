<% content_for :page_title, @country.name -%>
<% content_for :page_description, "Details for #{@country.name}" -%>
<% content_for :page_actions do %>
  <%= link_to countries_path, class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
    Back to countries
  <% end %>
<% end -%>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2">
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
        <div class="flex items-center">
          <%= image_tag country_flag_path(@country), class: 'h-8 w-12 mr-3' %>
          <h3 class="text-lg font-medium leading-6 text-gray-900">Country Information</h3>
        </div>
      </div>
      <dl>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Name</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @country.name %></dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">ISO 2-char Code</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <span class="font-mono font-bold"><%= @country.iso_2char_code || '-' %></span>
          </dd>
        </div>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">ISO 3-char Code</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <span class="font-mono font-bold"><%= @country.iso_3char_code || '-' %></span>
          </dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Capital</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @country.capital || '-' %></dd>
        </div>
      </dl>
    </div>
  </div>

  <div>
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
        <h3 class="text-lg font-medium leading-6 text-gray-900">Statistics</h3>
      </div>
      <dl>
        <div class="bg-gray-50 px-4 py-5 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Airports</dt>
          <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @country.airports_count %></dd>
        </div>
        <div class="bg-white px-4 py-5 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Operators</dt>
          <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @country.operators_count %></dd>
        </div>
      </dl>
    </div>
  </div>
</div>