<% content_for :page_title, @route.call_sign || "Route ##{@route.id}" -%>
<% content_for :page_description, "Details for #{@route.call_sign || "Route ##{@route.id}"}" -%>
<% content_for :page_actions do %>
  <%= link_to routes_path, class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
    Back to routes
  <% end %>
<% end -%>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2">
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
        <h3 class="text-lg font-medium leading-6 text-gray-900">Route Information</h3>
      </div>
      <dl>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Call Sign</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <span class="font-mono font-bold"><%= @route.call_sign || '-' %></span>
          </dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Operator</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <%= link_to @route.operator.name, operator_path(@route.operator), class: "text-indigo-600 hover:text-indigo-500" %>
            <% if @route.operator.icao_code %>
              <span class="text-gray-500">(<%= @route.operator.icao_code %>)</span>
            <% end %>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <div>
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
        <h3 class="text-lg font-medium leading-6 text-gray-900">Statistics</h3>
      </div>
      <dl>
        <div class="bg-gray-50 px-4 py-5 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Segments</dt>
          <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @route.route_segments_count %></dd>
        </div>
      </dl>
    </div>
  </div>
</div>

<% if @route.route_segments.any? %>
  <div class="mt-8">
    <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">Route Segments</h3>
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Airport</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Arrival</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Departure</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @route.route_segments.order(:order).each do |segment| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= segment.order %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900">
                  <%= link_to segment.airport.name, airport_path(segment.airport), class: "text-indigo-600 hover:text-indigo-500" %>
                </div>
                <div class="text-sm text-gray-500"><%= segment.airport.icao_code %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= segment.arrival_time&.strftime('%H:%M') || '-' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= segment.departing_time&.strftime('%H:%M') || '-' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>