<% content_for :page_title, @airport.name -%>
<% content_for :page_description, "Details for #{@airport.name}" -%>
<% content_for :page_actions do %>
  <%= link_to airports_path, class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
    Back to airports
  <% end %>
<% end -%>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2">
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
        <h3 class="text-lg font-medium leading-6 text-gray-900">Airport Information</h3>
      </div>
      <dl>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Name</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @airport.name %></dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">ICAO Code</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <span class="font-mono font-bold"><%= @airport.icao_code || '-' %></span>
          </dd>
        </div>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">IATA Code</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <span class="font-mono font-bold"><%= @airport.iata_code || '-' %></span>
          </dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">City</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @airport.city || '-' %></dd>
        </div>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Country</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <% if @airport.country %>
              <div class="flex items-center">
                <% flag_code = @airport.country.iso_2char_code&.downcase || 'xx' %>
                <%= image_tag "country_flags/#{flag_code}.svg", class: 'h-4 w-6 mr-2' %>
                <%= @airport.country.name %>
              </div>
            <% else %>
              -
            <% end %>
          </dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Coordinates</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <% if @airport.latitude && @airport.longitude %>
              <span class="font-mono"><%= number_with_precision(@airport.latitude, precision: 6) %>, <%= number_with_precision(@airport.longitude, precision: 6) %></span>
            <% else %>
              -
            <% end %>
          </dd>
        </div>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Elevation</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <% if @airport.altitude %>
              <%= number_with_precision(@airport.altitude, precision: 0) %> ft
            <% else %>
              -
            <% end %>
          </dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Timezone</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @airport.timezone || '-' %></dd>
        </div>
      </dl>
    </div>
  </div>

  <div>
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
        <h3 class="text-lg font-medium leading-6 text-gray-900">Statistics</h3>
      </div>
      <dl>
        <div class="bg-gray-50 px-4 py-5 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Runways</dt>
          <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @airport.airport_runways_count %></dd>
        </div>
      </dl>
    </div>
  </div>
</div>

<% if @airport.airport_runways.any? %>
  <div class="mt-8">
    <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">Runways</h3>
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Runway</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dimensions</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Surface</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @airport.airport_runways.each do |runway| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= runway.display_name %></div>
                <% if runway.heading.present? %>
                  <div class="text-sm text-gray-500">Heading: <%= number_with_precision(runway.heading, precision: 0) %>&deg;</div>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <% if runway.length.present? && runway.width.present? %>
                  <div><%= number_with_precision(runway.length, precision: 0) %>m &times; <%= number_with_precision(runway.width, precision: 0) %>m</div>
                  <div class="text-xs text-gray-400">(<%= number_with_precision(runway.length * 3.28084, precision: 0) %>ft)</div>
                <% else %>
                  -
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= surface_display_name(runway.surface) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center gap-2">
                  <% if runway.closed? %>
                    <span class="inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/10">Closed</span>
                  <% else %>
                    <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Open</span>
                  <% end %>
                  <% if runway.lighted? %>
                    <i class="fa-solid fa-lightbulb text-amber-400" title="Lighted"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>