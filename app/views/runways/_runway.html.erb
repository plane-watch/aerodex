<tr class="">
  <td class="whitespace-nowrap py-5 pl-4 pr-3 text-sm sm:pl-0">
    <div class="flex items-center">
      <div class="size-14 ml-1 bg-gray-200 border-2 border-emerald-700 rounded-2xl overflow-hidden flex items-center">
        <i class="fa-solid fa-road size-10 mx-auto text-emerald-400"></i>
      </div>
      <div class="ml-4">
        <span class="font-medium text-gray-900"><%= runway.display_name %></span>
        <% if runway.heading.present? %>
          <div class="mt-1 text-gray-500">
            Heading: <%= number_with_precision(runway.heading, precision: 0) %>&deg;
          </div>
        <% end %>
      </div>
    </div>
  </td>
  <td class="whitespace-nowrap px-3 py-5 text-sm text-gray-500">
    <div class="text-gray-900 font-medium">
      <%= runway.airport&.icao_code || '-' %>
    </div>
    <div class="text-gray-500 text-xs truncate max-w-48">
      <%= runway.airport&.name %>
    </div>
  </td>
  <td class="whitespace-nowrap px-3 py-5 text-sm text-gray-500">
    <% if runway.length.present? && runway.width.present? %>
      <div class="text-gray-900">
        <%= number_with_precision(runway.length, precision: 0) %>m &times; <%= number_with_precision(runway.width, precision: 0) %>m
      </div>
      <div class="text-gray-500 text-xs">
        (<%= number_with_precision(runway.length * 3.28084, precision: 0) %>ft)
      </div>
    <% else %>
      <span class="text-gray-400">-</span>
    <% end %>
  </td>
  <td class="whitespace-nowrap px-3 py-5 text-sm hidden lg:table-cell">
    <div class="text-gray-900">
      <%= surface_display_name(runway.surface) %>
    </div>
  </td>
  <td class="whitespace-nowrap px-3 py-5 text-sm text-gray-500">
    <div class="flex items-center gap-2">
      <% if runway.closed? %>
        <span class="inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/10">
          Closed
        </span>
      <% else %>
        <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
          Open
        </span>
      <% end %>
      <% if runway.lighted? %>
        <i class="fa-solid fa-lightbulb text-amber-400" title="Lighted"></i>
      <% end %>
    </div>
  </td>
  <td>
    <div class="pl-6 space-x-1">
      <%= link_to '#', title: 'edit' do %>
        <div class="group inline-flex items-center rounded px-2 py-0.5
                          border-2 border-indigo-100 bg-indigo-100
                          hover:border-indigo-300 shadow-2xl shadow-indigo-500/50">
          <i class="size-3 fa-regular fa-pen-to-square text-indigo-500"></i>
          <span class="text-indigo-900 text-right text-xs ml-1">edit</span>
        </div>
      <% end %>
      <%= link_to '#', title: 'Flag as incorrect',
                  class: '' do %>
        <div class="group inline-flex items-center rounded px-2 py-0.5
                          border-2 border-yellow-100 bg-yellow-100
                          hover:border-amber-300 shadow-2xl shadow-yellow-500/50">
          <i class="size-3 fa-solid fa-flag text-amber-500"></i>
          <span class="text-amber-900 text-right text-xs ml-1">flag</span>
        </div>
      <% end %>
    </div>
  </td>
</tr>
<% if @pagy.last == @pagy.page %>
  <div class="hidden" data-no-more-records></div>
<% end %>