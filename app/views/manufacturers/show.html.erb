<% content_for :page_title, @manufacturer.name -%>
<% content_for :page_description, "Details for #{@manufacturer.name}" -%>
<% content_for :page_actions do %>
  <%= link_to manufacturers_path, class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
    Back to manufacturers
  <% end %>
<% end -%>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2">
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
        <h3 class="text-lg font-medium leading-6 text-gray-900">Manufacturer Information</h3>
      </div>
      <dl>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Name</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @manufacturer.name %></dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">ICAO Code</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <span class="font-mono font-bold"><%= @manufacturer.icao_code || '-' %></span>
          </dd>
        </div>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Country</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <% if @manufacturer.country %>
              <div class="flex items-center">
                <% flag_code = @manufacturer.country.iso_2char_code&.downcase || 'xx' %>
                <%= image_tag "country_flags/#{flag_code}.svg", class: 'h-4 w-6 mr-2' %>
                <%= link_to @manufacturer.country.name, country_path(@manufacturer.country), class: "text-indigo-600 hover:text-indigo-500" %>
              </div>
            <% else %>
              -
            <% end %>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <div>
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
        <h3 class="text-lg font-medium leading-6 text-gray-900">Statistics</h3>
      </div>
      <dl>
        <div class="bg-gray-50 px-4 py-5 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Aircraft Types</dt>
          <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @manufacturer.aircraft_types_count %></dd>
        </div>
        <div class="bg-white px-4 py-5 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Total Aircraft</dt>
          <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @manufacturer.aircraft_count %></dd>
        </div>
      </dl>
    </div>
  </div>
</div>

<% if @aircraft_types.any? %>
  <div class="mt-8">
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
        <h3 class="text-lg font-medium leading-6 text-gray-900">Aircraft Types</h3>
      </div>
      <div class="flow-root">
        <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
          <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
            <table class="min-w-full divide-y divide-gray-300">
              <thead>
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">
                  Type
                </th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
                  Type Code
                </th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 hidden lg:table-cell">
                  Category
                </th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
                  Engines
                </th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
                  Aircraft Count
                </th>
                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                  <span class="sr-only">View</span>
                </th>
              </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 bg-white">
              <% @aircraft_types.each do |aircraft_type| %>
                <tr>
                  <td class="whitespace-nowrap py-5 pl-4 pr-3 text-sm sm:pl-6">
                    <div class="flex items-center">
                      <div class="size-14 ml-1 bg-gray-200 border-2 border-purple-700 rounded-2xl overflow-hidden flex items-center">
                        <i class="fa-solid fa-rectangle-list size-10 mx-auto text-purple-400"></i>
                      </div>
                      <div class="ml-4">
                        <%= link_to aircraft_type_path(aircraft_type), class: "font-medium text-gray-900 hover:text-indigo-600" do %>
                          <%= aircraft_type.full_name %>
                        <% end %>
                        <% if aircraft_type.type_code %>
                          <div class="mt-1 text-gray-500">
                            <%= aircraft_type.type_code %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <td class="whitespace-nowrap px-3 py-5 text-sm text-gray-500">
                    <div class="text-gray-900">
                      <%= aircraft_type.type_code || '-' %>
                    </div>
                  </td>
                  <td class="whitespace-nowrap px-3 py-5 text-sm hidden lg:table-cell">
                    <div class="text-gray-900">
                      <%= aircraft_type.category&.titleize || 'Unknown' %>
                    </div>
                  </td>
                  <td class="whitespace-nowrap px-3 py-5 text-sm text-gray-500">
                    <div class="text-gray-900">
                      <%= aircraft_type.engines || '-' %>
                      <% if aircraft_type.engine_type %>
                        <span class="text-gray-500">(<%= aircraft_type.engine_type %>)</span>
                      <% end %>
                    </div>
                  </td>
                  <td class="whitespace-nowrap px-3 py-5 text-sm text-gray-500">
                    <div class="text-gray-900">
                      <%= aircraft_type.aircraft_count %>
                    </div>
                  </td>
                  <td class="whitespace-nowrap py-5 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                    <%= link_to 'View', aircraft_type_path(aircraft_type), class: "text-indigo-600 hover:text-indigo-900" %>
                  </td>
                </tr>
              <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>