#!/bin/sh -e

# Enable jemalloc for reduced memory usage and latency if available.
if [ -z "${LD_PRELOAD+x}" ]; then
  LD_PRELOAD=$(find /usr -name libjemalloc.so.2 -print -quit 2>/dev/null)
  export LD_PRELOAD
fi

# Remove a potentially stale PID file left by a previous container run.
rm -f tmp/pids/server.pid

# Run pending database migrations automatically on container start.
if [ "${SKIP_MIGRATIONS}" != "true" ]; then
  ./bin/rails db:prepare
fi

# Run seeds and data import on first run (development only).
# The marker file prevents re-running on subsequent container starts.
if [ "${RAILS_ENV}" = "development" ] && [ ! -f tmp/.docker_seeded ]; then
  echo "==> First run detected: seeding database..."
  ./bin/rails db:seed

  if [ -d db/sources ] && [ "$(ls -A db/sources/*.json 2>/dev/null)" ]; then
    echo "==> Importing sources..."
    ./bin/rails sources:import
    echo "==> Running all processors..."
    ./bin/rails processors:run_all_sync
  else
    echo "==> No source files found in db/sources/, skipping import and processors."
  fi

  mkdir -p tmp
  touch tmp/.docker_seeded
  echo "==> First-run setup complete."
fi

exec "${@}"
